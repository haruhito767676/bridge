{
  "name": "bridge",
  "version": "0.1.0",
  "description": "Mac/Windows 間でファイルやクリップボードを共有するユーティリティ (プロトタイプ: Yoink 風ファイルシェルフ)",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac"
  },
  "author": "haruhito767676",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.haruhito767676.bridge",
    "productName": "Bridge",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "control-windows.js",
      "control-net.js",
      "control-input.js",
      "mouse-capture.js",
      "hud.html",
      "hud.css",
      "hud-renderer.js",
      "overlay.html",
      "overlay.css",
      "overlay-renderer.js",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**",
      "node_modules/uiohook-napi/**"
    ],
    "protocols": {
      "name": "Bridge URL Scheme",
      "schemes": [
        "bridge"
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "uiohook-napi": "^1.5.5"
  }
}
